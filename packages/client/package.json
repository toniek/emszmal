{
  "name": "@toniekw/emszmal-client",
  "version": "0.1.0",
  "description": "Typed Node.js client for emSzmal Banking API with isolated sessions and second-phase authentication",
  "license": "MIT",
  "author": { "name": "Tomasz Winter", "url": "https://github.com/toniek" },
  "repository": { "type": "git", "url": "git+https://github.com/toniek/emszmal.git", "directory": "packages/client" },
  "bugs": { "url": "https://github.com/toniek/emszmal/issues" },
  "homepage": "https://github.com/toniek/emszmal/tree/main/packages/client#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "keywords": ["emszmal", "banking", "api", "typescript"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node ../../scripts/build.mjs client",
    "prepack": "npm run build"
  },
  "dependencies": { "tough-cookie": "^6.0.0" }
}
