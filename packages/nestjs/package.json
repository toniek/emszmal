{
  "name": "@toniekw/nestjs-emszmal",
  "version": "0.1.0",
  "description": "Configurable NestJS module for the emSzmal Banking API client",
  "license": "MIT",
  "author": { "name": "Tomasz Winter", "url": "https://github.com/toniek" },
  "repository": { "type": "git", "url": "git+https://github.com/toniek/emszmal.git", "directory": "packages/nestjs" },
  "bugs": { "url": "https://github.com/toniek/emszmal/issues" },
  "homepage": "https://github.com/toniek/emszmal/tree/main/packages/nestjs#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "keywords": ["emszmal", "nestjs", "banking", "typescript"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node ../../scripts/build.mjs nestjs",
    "prepack": "npm run build"
  },
  "dependencies": { "@toniekw/emszmal-client": "^0.1.0" },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  }
}
