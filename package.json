{
  "name": "emszmal-libraries",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": { "name": "Tomasz Winter", "url": "https://github.com/toniek" },
  "repository": { "type": "git", "url": "git+https://github.com/toniek/emszmal.git" },
  "bugs": { "url": "https://github.com/toniek/emszmal/issues" },
  "homepage": "https://github.com/toniek/emszmal#readme",
  "workspaces": ["packages/*"],
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "scripts": {
    "build": "node scripts/build.mjs all",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "npm run build && node --test --experimental-test-isolation=none tests/*.test.mjs",
    "test:watch": "node --test --watch --experimental-test-isolation=none tests/*.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-isolation=none --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test-coverage-include='packages/*/dist/cjs/*.js' tests/*.test.mjs",
    "test:packages": "npm run build && node scripts/test-packages.mjs",
    "test:live": "npm run build && node scripts/test-live.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:packages",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typescript": "~5.9.3",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
  }
}
